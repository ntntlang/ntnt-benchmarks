import { json, html, text, parse_json } from "std/http/server"
import { connect, query } from "std/db/postgres"
import { get_env } from "std/env"
import { random_int } from "std/math"

let db_url = get_env("DATABASE_URL") ?? ""
let pg = if db_url != "" {
    match connect(db_url) {
        Ok(conn) => conn,
        Err(e) => {
            print("PostgreSQL unavailable for DB benchmarks: #{e}")
            None
        }
    }
} else {
    None
}

fn has_db() -> Bool {
    return pg != None
}

fn safe_int(value: Any, fallback: Int) -> Int {
    let parsed = int(str(value)) otherwise {
        return fallback
    }
    return parsed
}

fn plaintext(req: Map) -> Map {
    return text("Hello, World!")
}

fn json_test(req: Map) -> Map {
    return json(map { "message": "Hello, World!" })
}

fn user_by_id(req: Map) -> Map {
    let id = req["params"]["id"] ?? "0"
    return json(map { "id": id })
}

fn db_single(req: Map) -> Map {
    if !has_db() {
        return json(map { "skipped": true, "reason": "DATABASE_URL is not set or PostgreSQL is unavailable" }, 503)
    }
    let id = random_int(1, 10000)
    let rows = query(pg, "SELECT id, randomnumber FROM world WHERE id = $1", [id]) otherwise {
        return json(map { "error": "db error" }, 500)
    }
    let r = rows[0] ?? map {}
    return json(map { "id": r["id"] ?? 0, "randomNumber": r["randomnumber"] ?? 0 })
}

fn db_multi(req: Map) -> Map {
    if !has_db() {
        return json(map { "skipped": true, "reason": "DATABASE_URL is not set or PostgreSQL is unavailable" }, 503)
    }
    let params = req["query_params"] ?? map {}
    let mut count = safe_int(params["count"] ?? "1", 1)
    if count < 1 {
        count = 1
    }
    if count > 500 {
        count = 500
    }
    let mut results = []
    for i in 0..count {
        let id = random_int(1, 10000)
        let rows = query(pg, "SELECT id, randomnumber FROM world WHERE id = $1", [id]) otherwise {
            return json(map { "error": "db error" }, 500)
        }
        let r = rows[0] ?? map {}
        results = results + [map { "id": r["id"] ?? 0, "randomNumber": r["randomnumber"] ?? 0 }]
    }
    return json(results)
}

fn template_test(req: Map) -> Map {
    if !has_db() {
        return html("<h1>Database benchmark skipped</h1><p>Set DATABASE_URL to run /template.</p>", 503)
    }
    let mut items = []
    for i in 0..10 {
        let id = random_int(1, 10000)
        let rows = query(pg, "SELECT id, randomnumber FROM world WHERE id = $1", [id]) otherwise {
            return html("<h1>DB Error</h1>", 500)
        }
        let r = rows[0] ?? map {}
        items = items + [r]
    }
    let page = template("views/world.html", map { "items": items })
    return html(page)
}

fn json_body(req: Map) -> Map {
    let data = parse_json(req) otherwise {
        return json(map { "error": "invalid json" }, 400)
    }
    return json(data)
}

get("/plaintext", plaintext)
get("/json", json_test)
get("/users/{id}", user_by_id)
get("/db", db_single)
get("/queries", db_multi)
get("/template", template_test)
post("/json", json_body)

listen(3100)
